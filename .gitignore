# مرساة — Git ignore rules

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.pyo

# Virtual environments
.venv/
venv/
ENV/
env/

# uv
.uv/

# ─── Environment / Secrets ─────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.key
*.pem
secrets/
!.env.example
!**/.env.example

# ─── Flutter / Dart ────────────────────────────────────────────────────────
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.pub-cache/
app/.pub/
app/build/
app/android/.gradle/
app/android/captures/
app/android/local.properties
app/android/key.jks
app/ios/.symlinks/
app/ios/Flutter/flutter_export_environment.sh
app/ios/Flutter/Generated.xcconfig
app/ios/Pods/
app/linux/flutter/generated_plugin_registrant.cc
app/linux/flutter/generated_plugin_registrant.h
app/linux/flutter/generated_plugins.cmake
app/macos/Flutter/GeneratedPluginRegistrant.swift
app/macos/Flutter/ephemeral/
app/windows/flutter/generated_plugin_registrant.cc
app/windows/flutter/generated_plugin_registrant.h
app/windows/flutter/generated_plugins.cmake

# ─── Node.js / Next.js ─────────────────────────────────────────────────────
web/node_modules/
web/.next/
web/out/
web/.vercel/
web/.env
web/.env.local

# ─── IDEs ──────────────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Test artifacts ────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.lcov

# ─── Docker ────────────────────────────────────────────────────────────────
# Don't ignore docker-compose.yml — it's safe to commit (no secrets)
docker-compose.override.yml

# ─── Logs ──────────────────────────────────────────────────────────────────
*.log
logs/
