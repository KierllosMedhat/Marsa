# مرساة — Git ignore rules

# ─── Node.js / Next.js ─────────────────────────────────────────────────────
node_modules/
.next/
out/
.vercel/
next-env.d.ts
data/

# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.pyo
.venv/
venv/
ENV/
env/
.uv/

# ─── Environment / Secrets ─────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.key
*.pem
secrets/
!.env.example
!**/.env.example

# ─── Flutter / Dart (flutter_app) ──────────────────────────────────────────
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.pub-cache/
flutter_app/.pub/
flutter_app/build/
flutter_app/android/.gradle/
flutter_app/android/captures/
flutter_app/android/local.properties
flutter_app/android/key.jks
flutter_app/ios/.symlinks/
flutter_app/ios/Flutter/flutter_export_environment.sh
flutter_app/ios/Flutter/Generated.xcconfig
flutter_app/ios/Pods/
flutter_app/linux/flutter/generated_plugin_registrant.cc
flutter_app/linux/flutter/generated_plugin_registrant.h
flutter_app/linux/flutter/generated_plugins.cmake
flutter_app/macos/Flutter/GeneratedPluginRegistrant.swift
flutter_app/macos/Flutter/ephemeral/
flutter_app/windows/flutter/generated_plugin_registrant.cc
flutter_app/windows/flutter/generated_plugin_registrant.h
flutter_app/windows/flutter/generated_plugins.cmake

# Keep pre-compiled Flutter web portal in public/portal for instant Vercel deployment
!public/portal/
!public/portal/**

# ─── IDEs & Logs ───────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.swp
*.swo
.DS_Store
Thumbs.db
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.lcov
docker-compose.override.yml
*.log
logs/
