{
  "name": "marsa-clinic-platform",
  "version": "1.0.0",
  "private": true,
  "description": "مرساة — منصة العيادة النفسية الموحدة (Next.js Full-Stack + Flutter Portal)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "build:portal": "cd flutter_app && flutter build web --release --base-href /portal/",
