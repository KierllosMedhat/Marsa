# Environment Configuration for مرساة Clinic Platform
ENVIRONMENT=development
TIMEZONE=Africa/Cairo

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://marsa_user:marsa_password@localhost:5432/marsa_dev

# Redis Cache & Session Store
REDIS_URL=redis://localhost:6379/0

# JWT Configuration (RS256 - RSA 2048-bit key pair in PEM format)
# Note: For multi-line values in .env, either escape newlines with \n or enclose in quotes
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEAzD3...example...IDAQAB\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAzD3...example...IDAQAB\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Argon2 Password Hashing Parameters
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Field-level Encryption (AES-256-GCM key, 32 bytes base64-encoded)
# Example 32-byte key generated via base64.b64encode(os.urandom(32))
ENCRYPTION_KEY=dGhpcy1pcy1hLXRlc3QtMzItYnl0ZS1rZXktZm9yLWFlczI1Ng==
